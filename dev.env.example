# Easycard — local development
# Copy to dev.env and fill in local settings.
NODE_ENV="development"
PORT="1337"
# Local PostgreSQL — passwordless Unix socket
DATABASE_URL="postgres:///easycard?host=/var/run/postgresql"
# Enable only when the database requires TLS (certificate verification stays enabled).
DATABASE_SSL="false"
SESSION_SECRET=""
GOOGLE_CALLBACK="http://localhost:1337/auth/google/callback"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
STRIPE_PK=""
STRIPE_SK=""
LOB_API_KEY=""
LOB_API_TEST_KEY=""
